{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HostAblageAuflisten",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam:::user/<VERTRAGSNUMMER>:<NUTZER_UUID_HOST_ABLAGE>"
        ]
      },
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_ABLAGE>"
      ]
    },
    {
      "Sid": "HostAblageLesenSchreibenLoeschmarker",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam:::user/<VERTRAGSNUMMER>:<NUTZER_UUID_HOST_ABLAGE>"
        ]
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_ABLAGE>/*"
      ]
    },
    {
      "Sid": "HostAblageNieVersionenOderSchutzAendern",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "arn:aws:iam:::user/<VERTRAGSNUMMER>:<NUTZER_UUID_HOST_ABLAGE>"
        ]
      },
      "Action": [
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:DeleteBucket",
        "s3:PutBucketAcl",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_ABLAGE>",
        "arn:aws:s3:::<BUCKET_ABLAGE>/*"
      ]
    },
    {
      "Sid": "AndererHostNieZugriffAufAblage",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "arn:aws:iam:::user/<VERTRAGSNUMMER>:<NUTZER_UUID_HOST_WIDERRUFBUCH>"
        ]
      },
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_ABLAGE>",
        "arn:aws:s3:::<BUCKET_ABLAGE>/*"
      ]
    }
  ]
}
