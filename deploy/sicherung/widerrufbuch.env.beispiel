# =====================================================================
#  Konfiguration der Sicherung der Widerrufbücher (BE-3) — Vorlage
#  Ablage auf dem VPS: ~/.config/centric-sicherung/widerrufbuch.env   (chmod 600!)
#
#  NUR PLATZHALTER. Speicherziel, Zugangsdaten und ein kostenpflichtiger
#  Dienst brauchen die Freigabe des Betreibers (BE-3, 2026-11-14) — bis dahin
#  wird nichts davon eingetragen. Für Proben genügt ein LOKALES Repository
#  (RESTIC_REPOSITORY=/pfad/zu/einem/ordner, `restic init`), siehe
#  docs/BETRIEB-SICHERUNG.md §7.
#
#  Format wie env.beispiel (SCHLUESSEL=Wert, nicht ausgeführt, nur bekannte
#  Schlüssel; RESTIC_PASSWORD ist verboten — nur der Pfad zur Passwortdatei).
#  Bewusst eine EIGENE Datei: eigenes Repository (PFLICHT), eigenes Passwort,
#  eigener Alarm — getrennt von der Sicherung der Ablage (env).
#  Voraussetzung: restic >= 0.16.0 (--retry-lock); sonst Exit 78.
# =====================================================================

# Produktionsbild per Digest (wie env) — das Prüfwerkzeug läuft darin, ohne Netz.
CENTRIC_PROD_IMAGE=ghcr.io/rinats-png/dienstplaner@sha256:<DIGEST_DES_PRODUKTIONSBILDS>

# Daten der Anwendung (wird NICHT gesichert; nur für den Ort des Zustands
# und die Überlappungsprüfung)
CENTRIC_DATEN_PFAD=/opt/apps/centric-dienstplanung/data
# Zustandsverzeichnis mit zugang-widerrufe.json und konto-widerrufe.json
# (Vorgabe: $(dirname CENTRIC_DATEN_PFAD)/zustand)
# CENTRIC_ZUSTAND_PFAD=/opt/apps/centric-dienstplanung/zustand

# .env des Dienstes — daraus wird NUR CENTRIC_PFEFFER gelesen (Siegelprüfung).
CENTRIC_ENV_DATEI=/opt/apps/centric-dienstplanung/.env

# --- BETREIBERFREIGABE: Speicherziel (EIGENES Repository — Pflicht) ----
# NIE das Repository der Sicherung der Ablage (env): Dieser Job ruft stündlich
# `forget --prune` und `check` auf, die das Repository exklusiv sperren — die
# tägliche Sicherung der Ablage scheiterte sonst an der Sperre. Der Job
# vergleicht mit RESTIC_REPOSITORY aus `env` (neben dieser Datei bzw.
# ~/.config/centric-sicherung/env) und verweigert denselben Wert (Exit 78).
# Platzhalter — erst nach Freigabe ersetzen:
RESTIC_REPOSITORY=<ZIEL_NACH_FREIGABE>
# Betreiberentscheidung 2026-11-17: IONOS Object Storage, EIGENER Bucket mit
# Object Lock und EIGENER Nutzer/Schlüssel nur für diesen Bucket
# (deploy/sicherung/s3-policy-widerrufbuch.json.beispiel). Form (nicht eintragen ohne Freigabe):
#   RESTIC_REPOSITORY=s3:https://s3.<REGION>.ionoscloud.com/<BUCKET_WIDERRUFBUCH>/centric-widerrufbuch-restic
#   AWS_DEFAULT_REGION=<REGION>
#   AWS_ACCESS_KEY_ID=<SCHLUESSEL_ID_NUTZER_WIDERRUFBUCH>
#   AWS_SECRET_ACCESS_KEY=<GEHEIMNIS_NUTZER_WIDERRUFBUCH>
# NIE Bucket oder Schlüssel der Ablage (env). Alternative der Form: sftp:<host-alias>:/./centric-widerrufbuch-restic

# --- BETREIBERFREIGABE: restic-Passwort (eigene Datei, Modus 600) ------
# Anderes Passwort als für die Ablage. Kopie im Passwortmanager.
RESTIC_PASSWORD_FILE=~/.config/centric-sicherung/widerrufbuch-restic-passwort

# --- Alarm (Totmannschalter, eigener Check; Raster: stündlich, Karenz 2 h) ---
ALARM_PING_URL=
# Eigener Check für die monatliche Probe widerrufbuch-probe.sh (Raster ~31 Tage, Karenz 1 Tag);
# leer = ALARM_PING_URL (nicht empfohlen: ein Fehlschlag der Probe meldete sich dann als Ausfall des Jobs)
PROBE_PING_URL=

# --- optional ---------------------------------------------------------
# Statusdateien und Logs (Vorgabe ~/sicherung; die Statusdatei heißt
# widerrufbuch-status.json und wird im Container über
# CENTRIC_WIDERRUFBUCH_SICHERUNG_STATUS gelesen)
# STATUS_VERZEICHNIS=~/sicherung
# Host-Kennung der Snapshots. Nach der ersten Sicherung NICHT mehr ändern:
# ohne Snapshot für die Kennung verweigert der Job (Exit 5, „vergleich-fehlt“),
# bis der Betreiber bewusst `--erster-lauf` gibt (BETRIEB-SICHERUNG.md §7).
# RESTIC_HOST=centric
# CHECK_ANTEIL=100%
# ZEITGRENZE_RESTIC=600
# ZEITGRENZE_CONTAINER=300
# RESTIC_BIN=~/.local/bin/restic
