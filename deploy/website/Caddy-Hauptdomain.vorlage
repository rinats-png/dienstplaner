# CENTRIC – Caddy-Bausteine fuer die oeffentliche Website (Hauptdomain), VORLAGE.
# Nicht in die laufende Konfiguration kopieren, ohne vorher zu sichern (siehe website-ausliefern.sh, Abschnitt Sicherung).
# Die App (app.centric-dienstplanung.de) bleibt UNVERAENDERT in ihrem eigenen Block.
# Die Website ist rein statisch: Ausfall der App beruehrt sie nicht.

www.centric-dienstplanung.de {
	redir https://centric-dienstplanung.de{uri} permanent
}

centric-dienstplanung.de {
	root * /srv/centric-website
	encode zstd gzip
	file_server
	# eigene 404-Seite der Website (dist/404.html)
	handle_errors {
		rewrite * /404.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	}
}
# DNS (bei IONOS, nur nach Nachweis noetig): A-Eintrag fuer "www" auf dieselbe IPv4-Adresse wie die Hauptdomain.
# Caddy holt die Zertifikate fuer beide Namen selbst (Port 80/443 muessen erreichbar sein).
