# =====================================================================
#  STAGING-VM (O2) — Konfiguration der Sicherung der Widerrufbücher (BE-3)
#  für die Übung mit ECHTEM restic >= 0.16.0 (schließt B3-8). Vorlage, nur
#  Platzhalter. Format und Schlüssel wie deploy/sicherung/widerrufbuch.env.beispiel.
#  Ablage auf der Staging-VM: ~/.config/centric-sicherung/widerrufbuch.env (chmod 600),
#  im SELBEN Ordner wie die env der Ablage (dann greift der Repository-Vergleich).
#  Anleitung: docs/acc45/INFRA-VORBEREITUNG-STAGING-BACKUP.md §5
#
#  EIGENES Repository (Pflicht, BE-3) mit EIGENEM Passwort — nie das der
#  Ablage, nie eines der Produktion; nur lokal auf der Staging-VM.
# =====================================================================

CENTRIC_PROD_IMAGE=ghcr.io/rinats-png/dienstplaner@sha256:<DIGEST_DES_STAGING_KANDIDATEN>

CENTRIC_DATEN_PFAD=/opt/centric-staging/data
CENTRIC_ZUSTAND_PFAD=/opt/centric-staging/zustand
CENTRIC_ENV_DATEI=/opt/centric-staging/.env

# Lokales Übungs-Repository der WIDERRUFBÜCHER (anderer Ordner, anderes Passwort)
RESTIC_REPOSITORY=/home/admin/restic-uebung/widerrufbuch
RESTIC_PASSWORD_FILE=~/.config/centric-sicherung/restic-passwort-uebung-widerrufbuch

# Eigene Checks: stündlicher Job (ALARM) und monatliche Probe (PROBE); im Staging leer oder Übungs-Checks
ALARM_PING_URL=
PROBE_PING_URL=

STATUS_VERZEICHNIS=~/sicherung-uebung
# Das Repository ist winzig: täglich ganz lesen statt 5 %
CHECK_ANTEIL=100%
ZEITGRENZE_RESTIC=600
ZEITGRENZE_CONTAINER=300
RESTIC_BIN=~/.local/bin/restic
