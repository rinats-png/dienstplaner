# =====================================================================
#  .env der Staging-VM (O2) — VORLAGE, enthält ausschließlich Platzhalter.
#  Auf der VM: cp env.staging.beispiel .env && chmod 600 .env
#  Jeden <...>-Wert ersetzt der Betreiber auf der VM. Die ausgefüllte .env
#  gehört NIE ins Repository, NIE in Chat, Ticket oder Workflow-Log.
#  Staging-Geheimnisse sind eigene Werte: nie die der Produktion wiederverwenden.
#  Erzeugen (auf der VM, Ausgabe nicht anzeigen oder weitergeben):
#    openssl rand -hex 32     -> je ein eigener Wert für Pfeffer und Verwalterschlüssel
# =====================================================================

# --- Bild und Zugang (Compose) ---
IMAGE_DIGEST=sha256:<64-hex-digest-des-release-kandidaten>
CADDY_DIGEST=sha256:<64-hex-digest-des-caddy-bilds>
STAGING_HOST=staging.<domain>
STAGING_ERLAUBT=<betreiber-ip>/32 <pruefgeraet-ip>/32

# --- Anwendung (eigene Geheimnisse, nur Staging) ---
CENTRIC_ADMIN=<eigener-verwalterschluessel-staging>
CENTRIC_PFEFFER=<eigener-pfeffer-staging>
CENTRIC_BASIS=https://staging.<domain>

# --- Funktionen: wie die Produktion, Vorgabe AUS ---
# CENTRIC_SELBSTSTART und CENTRIC_DEMO bleiben ungesetzt. Synthetische Testbetriebe legt der Betreiber
# über /einrichten und die Gate-Proben an (werkzeug/staging-smoke.mjs, Räume ppg-gate-a/-b; siehe STAGING-O2-VORBEREITUNG.md).
# Mail und Push: im Staging KEINE Anbieter eintragen (Zustellung nur auf Testadressen, Entscheidung offen).
