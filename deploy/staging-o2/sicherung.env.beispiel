# =====================================================================
#  STAGING-VM (O2) — Konfiguration der Sicherung der Ablage für die
#  Übung mit ECHTEM restic. Vorlage, nur Platzhalter. Format und Schlüssel
#  wie deploy/sicherung/env.beispiel (gelesen von gemeinsam.sh, nicht
#  ausgeführt; RESTIC_PASSWORD ist verboten).
#  Ablage auf der Staging-VM: ~/.config/centric-sicherung/env   (chmod 600)
#  Anleitung: docs/acc45/INFRA-VORBEREITUNG-STAGING-BACKUP.md §5
#
#  Trennung (Pflicht): Repository NUR lokal auf der Staging-VM (kein
#  Speicherziel außer Haus, keine Zugangsdaten eines Anbieters, keine
#  Kosten), eigenes Passwort, erzeugt auf der Staging-VM. Nie Pfade,
#  Passwörter, Repositorys oder Ping-URLs der Produktion.
# =====================================================================

# Bild des Staging-Kandidaten per Digest (derselbe wie IMAGE_DIGEST in /opt/centric-staging/.env)
CENTRIC_PROD_IMAGE=ghcr.io/rinats-png/dienstplaner@sha256:<DIGEST_DES_STAGING_KANDIDATEN>

# Synthetische Daten des Staging (deploy/staging-o2/compose.yml: ./data, ./zustand)
CENTRIC_DATEN_PFAD=/opt/centric-staging/data
CENTRIC_ENV_DATEI=/opt/centric-staging/.env

# Lokales Übungs-Repository der ABLAGE (anderer Ordner als das der Widerrufbücher)
RESTIC_REPOSITORY=/home/admin/restic-uebung/ablage
RESTIC_PASSWORD_FILE=~/.config/centric-sicherung/restic-passwort-uebung-ablage

# Totmannschalter: im Staging leer lassen ODER eigene Übungs-Checks (nie die der Produktion)
ALARM_PING_URL=
PROBE_PING_URL=

STATUS_VERZEICHNIS=~/sicherung-uebung
# Kurze Zeitgrenzen: die Übungsdaten sind klein
ZEITGRENZE_RESTIC=900
ZEITGRENZE_CONTAINER=300
RESTIC_BIN=~/.local/bin/restic
