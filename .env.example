# =====================================================================
#  CENTRIC — Laufzeitumgebung (Vorlage)
#
#  Kopieren nach /opt/apps/centric-dienstplanung/.env, Rechte 600.
#  Die echte .env gehört NIE in Git. Werte in <…> sind auszufüllen.
#  Was fehlt, schaltet nur die jeweilige Funktion ab — die Anwendung
#  läuft trotzdem (siehe BEREITSTELLUNG.md).
# =====================================================================

# --- Container-Bild: NUR per Digest (Pflicht, keine Vorgabe) ---
# Digest mit Status "aktiv" aus deploy/FREIGEGEBENE-IMAGES.md, vorher
# ./digest-pruefen.sh <digest>. Kein Tag, kein latest; IMAGE_TAG wird
# nicht mehr gelesen. Nie zusätzlich in der Shell exportieren.
IMAGE_DIGEST=sha256:<aus FREIGEGEBENE-IMAGES.md>

# --- Server ---
NODE_ENV=production
PORT=3000
CENTRIC_DATEN=/data
CENTRIC_ABLAGE=dateien

# --- Adresse der Anwendung (Einladungs- und Rücksetzlinks) ---
CENTRIC_BASIS=https://app.centric-dienstplanung.de

# --- Pflicht hinter Caddy: wem X-Forwarded-For geglaubt wird (B-XFF-1).
#     NUR Caddys feste Adresse im Docker-Netz "proxy" (in Caddys Compose
#     mit ipv4_address festlegen). Leer = niemandem: Dann zählen ALLE
#     Nutzer unter der Adresse des Caddy-Containers, und die Bremse träfe
#     alle gemeinsam — deploy.sh liefert dann nicht aus. Das ganze Subnetz
#     ist NICHT empfohlen: Jeder Container im Netz könnte seine Herkunft
#     frei wählen (docs/CADDY-UND-XFF.md, Abschnitt 7).
CENTRIC_VERTRAUTE_PROXYS=<FESTE_ADRESSE_DES_CADDY_CONTAINERS>

# --- Täglicher Löschlauf für abgelaufene Testbetriebe (30 Tage Test,
#     danach 90 Tage Aufbewahrung, dann vollständige Löschung).
#     Vorgabe: an. Nur zum Abschalten setzen. ---
# CENTRIC_AUFRAEUMEN=aus

# --- Datenschutzlauf (WP-26): Aufbewahrungsfristen jedes Betriebs, In-App-
#     Sicherungen nach festem Plan, Protokoll nach 30 Tagen. Läuft täglich mit
#     dem Löschlauf oben (CENTRIC_AUFRAEUMEN=aus schaltet beide ab).
#     aus      — gar nicht
#     vorschau — Vorgabe: rechnet und berichtet (Protokoll, Vermerk
#                datenschutzlauf:letzter), löscht NICHTS
#     an       — löscht nach den Fristen; vorher je Raum eine automatische
#                Sicherung. Erst einschalten, nachdem der Vorschau-Bericht
#                geprüft und die Fristen jedes Betriebs mit der Leitung
#                abgestimmt sind (Plan-, Zeit- und Stempeldaten nie unter
#                24 Monaten, § 16 Abs. 2 ArbZG, § 17 MiLoG).
#     Zurückschalten von „an" auf „vorschau"/„aus": Dann räumt auch das
#     Zurückspielen einer Sicherung nicht mehr nach Fristen — eine ältere
#     Sicherung bringt bereits gelöschte Angaben (z. B. Gründe) zurück, bis
#     wieder „an" gilt (bewusst, WP-26 N-3). ---
# CENTRIC_DATENSCHUTZLAUF=vorschau

# --- Öffentliche Selbstregistrierung (/api/registrierung*).
#     Vorgabe: AUS. Nur genau "true" schaltet sie ein — erst, wenn
#     Mailversand, Absenderdomain, End-to-End-Test, Aufräumen abgebrochener
#     Registrierungen und Rechtstexte stehen (BEREITSTELLUNG.md 5.8). ---
# CENTRIC_PUBLIC_REGISTRATION=true

# --- Zweiter Faktor als Pflicht (Vorgabe: aus; nur genau "1" schaltet ein).
#     Verwalterschlüssel (/einrichten): ab dem ersten eingerichteten Faktor
#     ohnehin Pflicht für alle; diese Variable setzt sie schon vorher.
#     Betreibercodes (Konsole): ohne eingerichteten Faktor keine Sitzung mehr.
#     Vorher den eigenen Zugang einrichten. Bestehende Sitzungen ohne Faktor
#     laufen nach dem Einschalten noch bis zu 2 h weiter (Einführungsreihenfolge:
#     docs/acc45/wp32b-nachweis.md, Abschnitt 4). ---
# CENTRIC_ZWEIFAKTOR_PFLICHT=1
# CENTRIC_BETREIBER_ZWEIFAKTOR_PFLICHT=1

# --- Überwachung und Alarm (WP-05, docs/BETRIEB-UEBERWACHUNG.md).
#     Alarmkanal Vorgabe AUS; die URL ist ein Geheimnis. Schwellen nur bei
#     Bedarf ändern (Vorgaben in Klammern). ---
# CENTRIC_ALARM_WEBHOOK=https://<ALARM_WEBHOOK>
# CENTRIC_GESUND_PLATZ_WARNUNG_PROZENT=15
# CENTRIC_GESUND_PLATZ_KRITISCH_PROZENT=3
# CENTRIC_GESUND_PLATZ_KRITISCH_MB=200
# CENTRIC_GESUND_SICHERUNG_WARNUNG_STUNDEN=26
# CENTRIC_GESUND_LOESCHLAUF_WARNUNG_STUNDEN=26
# CENTRIC_GESUND_5XX_WARNUNG=10
# CENTRIC_GESUND_ZEITGRENZE_MS=15000
# CENTRIC_GESUND_CACHE_MS=10000
# CENTRIC_GESUND_TAKT_S=60
# CENTRIC_ALARM_ENTPRELLUNG_S=120
# CENTRIC_ALARM_WIEDERHOLUNG_S=21600
# Prüftakt abschalten (/gesund prüft weiter):
# CENTRIC_UEBERWACHUNG=aus
# Alter der Sicherung außer Haus (WP-04) prüfen — zusammen mit dem
# auskommentierten Mount in deploy/compose.yml einschalten:
# CENTRIC_SICHERUNG_STATUS=/sicherung-status/letzte-erfolgreiche.json

# --- Pflicht: Pfeffer für die Zugangscode-Hashes ---
# Erzeugen: openssl rand -base64 32
# VOR dem ersten Zugangscode setzen und danach NIE ÄNDERN.
CENTRIC_PFEFFER=<SECRET>

# --- Nur vorübergehend: Wegwerfschlüssel zum Anlegen des ersten
#     Verwalterkontos (BEREITSTELLUNG.md, Schritt 5.1).
#     PRODUKTION: nach dem ersten benannten Verwalterkonto entfernen und
#     den Container neu erstellen. STAGING: die Gate-Proben
#     (werkzeug/staging-*.mjs) brauchen ihn — dort nur für die Dauer der
#     Proben setzen (docs/PRE-PRODUCTION-GATE.md). ---
# Erzeugen: openssl rand -base64 24
CENTRIC_ADMIN=<TEMPORARY_SECRET>

# --- Optional: Push-Mitteilungen (Web Push, VAPID) ---
# Erzeugen: npx web-push generate-vapid-keys   (beide Hälften gehören zusammen)
VAPID_PUBLIC=<OPTIONAL>
VAPID_PRIVATE=<OPTIONAL>
VAPID_KONTAKT=mailto:info@centric-dienstplanung.de

# --- Optional: E-Mail-Versand über Resend ---
# CENTRIC_ABSENDER muss eine bei Resend verifizierte Domain tragen;
# onboarding@resend.dev ist nur die Sandbox.
RESEND_API_KEY=<OPTIONAL>
CENTRIC_ABSENDER=<OPTIONAL>

# --- Optional: atomare Bremse über Redis-REST (Upstash-kompatibel).
#     Ohne diese Angaben zählt die Bremse über die Ablage. ---
REDIS_REST_URL=<OPTIONAL>
REDIS_REST_TOKEN=<OPTIONAL>

# --- NIE in Produktion setzen: nur für die Prüfungen. ---
# CENTRIC_STATIK=<anderes Verzeichnis statt dist/>
# CENTRIC_PRUEFLINK=ja   (wirkt nur ohne RESEND_API_KEY und nie bei NODE_ENV=production)

# --- Nicht in dieser Datei: deploy/deploy.sh liest seine Einstellungen aus
#     der Shell, nicht aus der .env (docs/DEPLOY-AUTOMATISIERUNG.md):
#     CENTRIC_DEPLOY_BEHALTEN (5), CENTRIC_DEPLOY_SICHERUNGEN, CENTRIC_DATEN_PFAD,
#     CENTRIC_WARTEZEIT (150, mindestens 90), CENTRIC_TAKT (2). ---
