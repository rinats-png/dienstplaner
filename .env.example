# =====================================================================
#  CENTRIC — Laufzeitumgebung (Vorlage)
#
#  Kopieren nach /opt/apps/centric-dienstplanung/.env, Rechte 600.
#  Die echte .env gehört NIE in Git. Werte in <…> sind auszufüllen.
#  Was fehlt, schaltet nur die jeweilige Funktion ab — die Anwendung
#  läuft trotzdem (siehe BEREITSTELLUNG.md).
# =====================================================================

# --- Container-Bild: NUR per Digest (Pflicht, keine Vorgabe) ---
# Digest mit Status "aktiv" aus deploy/FREIGEGEBENE-IMAGES.md, vorher
# ./digest-pruefen.sh <digest>. Kein Tag, kein latest; IMAGE_TAG wird
# nicht mehr gelesen. Nie zusätzlich in der Shell exportieren.
IMAGE_DIGEST=sha256:<aus FREIGEGEBENE-IMAGES.md>

# --- Server ---
NODE_ENV=production
PORT=3000
CENTRIC_DATEN=/data
CENTRIC_ABLAGE=dateien

# --- Adresse der Anwendung (Einladungs- und Rücksetzlinks) ---
CENTRIC_BASIS=https://app.centric-dienstplanung.de

# --- Pflicht hinter Caddy: wem X-Forwarded-For geglaubt wird (B-XFF-1).
#     Adressen oder Netze (CIDR), durch Komma getrennt. Leer = niemandem:
#     Dann zählen ALLE Nutzer unter der Adresse des Caddy-Containers, und
#     die Bremse träfe alle gemeinsam. Wert = Subnetz des Docker-Netzes
#     "proxy" (docs/CADDY-UND-XFF.md, Abschnitt 7):
#       docker network inspect proxy --format '{{(index .IPAM.Config 0).Subnet}}'
CENTRIC_VERTRAUTE_PROXYS=<SUBNETZ_DES_NETZES_PROXY>

# --- Täglicher Löschlauf für abgelaufene Testbetriebe (30 Tage Test,
#     danach 90 Tage Aufbewahrung, dann vollständige Löschung).
#     Vorgabe: an. Nur zum Abschalten setzen. ---
# CENTRIC_AUFRAEUMEN=aus

# --- Öffentliche Selbstregistrierung (/api/registrierung*).
#     Vorgabe: AUS. Nur genau "true" schaltet sie ein — erst, wenn
#     Mailversand, Absenderdomain, End-to-End-Test, Aufräumen abgebrochener
#     Registrierungen und Rechtstexte stehen (BEREITSTELLUNG.md 5.8). ---
# CENTRIC_PUBLIC_REGISTRATION=true

# --- Zweiter Faktor als Pflicht (Vorgabe: aus; nur genau "1" schaltet ein).
#     Verwalterschlüssel (/einrichten): ab dem ersten eingerichteten Faktor
#     ohnehin Pflicht für alle; diese Variable setzt sie schon vorher.
#     Betreibercodes (Konsole): ohne eingerichteten Faktor keine Sitzung mehr.
#     Vorher den eigenen Zugang einrichten (docs/acc45/wp32b-nachweis.md). ---
# CENTRIC_ZWEIFAKTOR_PFLICHT=1
# CENTRIC_BETREIBER_ZWEIFAKTOR_PFLICHT=1

# --- Pflicht: Pfeffer für die Zugangscode-Hashes ---
# Erzeugen: openssl rand -base64 32
# VOR dem ersten Zugangscode setzen und danach NIE ÄNDERN.
CENTRIC_PFEFFER=<SECRET>

# --- Nur vorübergehend: Wegwerfschlüssel zum Anlegen des ersten
#     Verwalterkontos (BEREITSTELLUNG.md, Schritt 5.1). Danach entfernen
#     und den Container neu starten. ---
# Erzeugen: openssl rand -base64 24
CENTRIC_ADMIN=<TEMPORARY_SECRET>

# --- Optional: Push-Mitteilungen (Web Push, VAPID) ---
# Erzeugen: npx web-push generate-vapid-keys   (beide Hälften gehören zusammen)
VAPID_PUBLIC=<OPTIONAL>
VAPID_PRIVATE=<OPTIONAL>
VAPID_KONTAKT=mailto:info@centric-dienstplanung.de

# --- Optional: E-Mail-Versand über Resend ---
# CENTRIC_ABSENDER muss eine bei Resend verifizierte Domain tragen;
# onboarding@resend.dev ist nur die Sandbox.
RESEND_API_KEY=<OPTIONAL>
CENTRIC_ABSENDER=<OPTIONAL>

# --- Optional: atomare Bremse über Redis-REST (Upstash-kompatibel).
#     Ohne diese Angaben zählt die Bremse über die Ablage. ---
REDIS_REST_URL=<OPTIONAL>
REDIS_REST_TOKEN=<OPTIONAL>
